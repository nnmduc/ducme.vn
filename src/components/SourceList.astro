---
/**
 * Danh muc nguon dan.
 *
 * Trinh bay dang luoi the, khong phai bang co gach ngang tung dong: moi ban
 * ghi co it nhat hai nguon, va bang gach ngang lam noi dung kho doc.
 *
 * Lien ket ra ngoai deu mang rel="nofollow noopener": day la nguon tham khao,
 * khong phai bao chung ve chat luong, va trang dich khong duoc truy nguoc window.
 */
const { sources } = Astro.props;

/** Hien ten mien de nguoi doc biet truoc minh sap roi khoi trang. */
function hostOf(url) {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
}

/**
 * Nhan cap nguon. Khoa "tier" la TUY CHON tren moi ban ghi nguon: ban ghi cu
 * chua co thi khong hien gi, khong can di sua lai toan bo du lieu.
 *
 * Ly do co nhan: du an chap nhan ca nguon mo (blog hanh huong, trang du lich,
 * dien dan) lam nguon tham khao. Neu the nguon nao cung giong nhau thi mot bai
 * blog se trong ngang hang mot ban van kho giao phan — nguoi doc mat can cu de
 * tu danh gia. Nhan nay tra lai can cu do.
 */
const TIER_LABEL = {
  A: { text: 'Nguồn gốc', hint: 'Văn khố, kỷ yếu, thư chung, bia ký — tư liệu gốc' },
  B: { text: 'Thứ cấp', hint: 'Trang giáo phận, báo có toà soạn, sách có nhà xuất bản' },
  C: { text: 'Tham khảo mở', hint: 'Blog, trang du lịch, diễn đàn — đọc tham khảo, chưa phải sử liệu' },
};
---

<div class="src-grid">
  {
    sources.map((source) => (
      <a class="src" href={source.url} rel="nofollow noopener" target="_blank">
        <span class="src-title">{source.title}</span>
        <span class="src-meta">
          <span class="src-host">
            {hostOf(source.url)}
            <span class="sr-only"> (mở trong tab mới)</span>
          </span>
          {TIER_LABEL[source.tier] && (
            <span class={`src-tier tier-${source.tier}`} title={TIER_LABEL[source.tier].hint}>
              {TIER_LABEL[source.tier].text}
            </span>
          )}
        </span>
      </a>
    ))
  }
</div>

<style>
  .src-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .src {
    display: block;
    background: var(--bg-page);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    padding: 20px;
    transition: border-color 0.2s, transform 0.16s;
  }
  .src:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .src-title {
    display: block;
    font-family: var(--font-prose);
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--text-primary);
    margin-bottom: 10px;
    transition: color 0.18s;
  }
  .src:hover .src-title {
    color: var(--accent-hover);
  }
  .src-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .src-host {
    font-size: 12px;
    color: var(--text-tertiary);
    word-break: break-all;
  }
  .src-tier {
    flex: none;
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.02em;
    padding: 3px 8px;
    border-radius: var(--radius);
    border: 1px solid var(--border-strong);
    color: var(--text-secondary);
    white-space: nowrap;
  }
  .src-tier.tier-A {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    color: var(--accent-hover);
  }
  .src-tier.tier-C {
    border-style: dashed;
  }
  @media (max-width: 880px) {
    .src-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
