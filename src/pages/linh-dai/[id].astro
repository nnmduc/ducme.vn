---
/**
 * Trang chi tiet mot linh dia. Cac trang tinh duoc sinh tu du lieu,
 * so luong bang MARIAN_STATUES_DATA.length.
 *
 * Day la be mat xep hang chinh cua toan trang. Toan bo van xuoi
 * (historicalFact, architect, oralTradition, significance) va danh muc nguon
 * deu nam trong HTML tra ve tu may chu, doc duoc khi TAT JavaScript.
 * Truoc day nhung noi dung nay chi xuat hien sau khi nguoi dung bam mo hop thoai,
 * nen bo thu thap khong bao gio nhin thay.
 */
import { Image } from 'astro:assets';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import SourceList from '../../components/SourceList.astro';

import { MARIAN_STATUES_DATA, CONSTELLATION_VERSIONS } from '../../data/statues.js';
import { getPhoto, getGalleryPhotos } from '../../lib/photos.js';
import {
  getProvince,
  getNeighbours,
  statuePath,
  formatCoords,
} from '../../lib/statues.js';
import {
  buildStatueTitle,
  buildStatueDescription,
  buildPlaceSchema,
  buildBreadcrumbSchema,
  absoluteUrl,
} from '../../lib/seo.js';

export function getStaticPaths() {
  return MARIAN_STATUES_DATA.map((statue) => ({
    params: { id: statue.id },
    props: { statue },
  }));
}

const { statue } = Astro.props;

const photo = getPhoto(statue.realImage);
const galleryPhotos = getGalleryPhotos(statue.galleryImages);
const province = getProvince(statue.location);
const { prev, next } = getNeighbours(statue.id);

const title = buildStatueTitle(statue);
const description = buildStatueDescription(statue);

/**
 * Hai cap, khong phai ba. Khong co trang muc luc rieng tai /linh-dai/, nen mot
 * cap trung gian tro toi /#danh-muc chi la manh neo cua chinh trang chu, khong
 * phai mot cap dieu huong that.
 */
const breadcrumbItems = [
  { name: 'Trang chủ', href: '/' },
  { name: statue.name, href: statuePath(statue.id) },
];

/**
 * og:image phai la URL tuyet doi. Mot so ban ghi chua co anh thuc dia (xem
 * truong `realImage` trong src/data/statues.js), nhung trang nao cung phai
 * co the chia se hop le, nen SeoHead se tu lui ve anh mac dinh khi khong
 * truyen gi.
 */
const ogImage = photo ? absoluteUrl(photo.src) : undefined;

const schemas = [
  buildPlaceSchema(statue, ogImage),
  buildBreadcrumbSchema(breadcrumbItems),
];

/** Vai tro cua linh dia trong tung phien ban chom sao, bo cac phien ban khong co mat. */
const roles = ['v1', 'v2', 'v3', 'v4']
  .map((key) => ({ key, version: CONSTELLATION_VERSIONS[key], role: statue.constellationRole?.[key] }))
  .filter((entry) => entry.role);

/** Gop v1 va v2 khi vai tro trung nhau, tranh lap lai y het nhau. */
const mergedRoles = roles.reduce((acc, entry) => {
  const previous = acc[acc.length - 1];
  if (previous && previous.role.star === entry.role.star && previous.role.code === entry.role.code) {
    previous.keys.push(entry.key);
    return acc;
  }
  acc.push({ keys: [entry.key], role: entry.role });
  return acc;
}, []);

const versionLabel = (keys) =>
  keys.length > 1
    ? `Phiên bản ${keys.map((k) => k.replace('v', '')).join(' và ')}`
    : `Phiên bản ${keys[0].replace('v', '')}`;

/**
 * Tach van xuoi thanh cac doan theo dong trong. Phan truyen tung co the gom
 * nhieu chuyen ke noi tiep nhau; don het vao mot the <p> thi thanh mot khoi
 * chu dai doc met.
 */
const paragraphs = (text) =>
  String(text || '')
    .split(/\n\s*\n/)
    .map((part) => part.trim())
    .filter(Boolean);

/**
 * Cac muc van xuoi. Bo muc rong de khong sinh tieu de trong.
 *
 * "Truyen tung dan gian" mang co `lore`: noi dung o day la chuyen ke luu truyen,
 * KHONG phai su kien da kiem chung. Nhan trong cau chu ("Tuong truyen...") chi an
 * voi nguoi doc tu dau cau, nen muc nay con duoc danh dau bang mot huy hieu va mot
 * khoi trinh bay rieng — de nguoi luot trang khong doc nham thanh su lieu.
 */
const proseSections = [
  { heading: 'Tư liệu lịch sử', body: statue.historicalFact, lead: true },
  { heading: 'Quần thể và kiến trúc', body: statue.architect },
  { heading: 'Truyền tụng dân gian', body: statue.oralTradition, lore: true },
  { heading: 'Giá trị tâm linh', body: statue.significance },
].filter((section) => section.body);
---

<BaseLayout
  title={title}
  description={description}
  image={photo?.src}
  imageWidth={photo?.width}
  imageHeight={photo?.height}
  type="article"
  schemas={schemas}
>
  <div class="wrap">
    <Breadcrumb items={breadcrumbItems} />

    <article>
      <header class="head">
        <h1>{statue.name}</h1>
        {statue.title && <p class="subtitle">{statue.title}</p>}
        <p class="place">
          {statue.location}
          <span class="dot" aria-hidden="true">·</span>
          {statue.diocese}
        </p>

        <div class="tags">
          <span class="tag">Thành lập {statue.year}</span>
          {statue.diemStatue5 && (
            <span class="tag diem">★ Một trong năm pho tượng dựng năm 1959</span>
          )}
          {statue.constellationRole?.v1 && (
            <span class="tag astro">
              {statue.constellationRole.v1.star}, {statue.constellationRole.v1.code}
            </span>
          )}
        </div>
      </header>

      {
        photo && (
          <figure class="hero-fig">
            <Image
              src={photo}
              alt={`${statue.name} tại ${province}`}
              widths={[640, 1024, 1600]}
              sizes="(max-width: 1240px) 100vw, 1192px"
              loading="eager"
              fetchpriority="high"
              format="avif"
            />
            <figcaption>{statue.realImageCaption}</figcaption>
          </figure>
        )
      }

      {
        galleryPhotos.length > 0 && (
          <>
            <div class="gallery-wrap">
              <p class="gallery-label">Ảnh khác ({galleryPhotos.length})</p>
              <div class="gallery" id="gallery">
                {galleryPhotos.map((entry, i) => (
                  <button
                    type="button"
                    class="gallery-open"
                    data-gallery-open={i}
                    aria-label={`Xem ảnh lớn ${i + 1}/${galleryPhotos.length}: ${entry.caption}`}
                  >
                    <Image
                      src={entry.photo}
                      alt={`${statue.name} tại ${province}`}
                      widths={[160, 320]}
                      sizes="88px"
                      loading="lazy"
                      format="avif"
                    />
                  </button>
                ))}
              </div>
            </div>

            <div class="lightbox" id="lightbox" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Xem ảnh lớn">
              <button type="button" class="lb-btn lb-close" data-lb-close aria-label="Đóng">✕</button>
              <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label="Ảnh trước">‹</button>
              <div class="lb-stage">
                {galleryPhotos.map((entry, i) => (
                  <figure class="lb-item" data-lb-item={i} hidden>
                    <Image
                      src={entry.photo}
                      alt={`${statue.name} tại ${province}`}
                      widths={[640, 1024, 1600]}
                      sizes="100vw"
                      loading="lazy"
                      format="avif"
                    />
                    <figcaption>{entry.caption}</figcaption>
                  </figure>
                ))}
              </div>
              <button type="button" class="lb-btn lb-next" data-lb-next aria-label="Ảnh kế tiếp">›</button>
              <div class="lb-counter"><span data-lb-current>1</span> / {galleryPhotos.length}</div>
            </div>
          </>
        )
      }

      <dl class="specs">
        <div class="spec">
          <dt>Tọa độ GPS</dt>
          <dd class="num">{formatCoords(statue.lat, statue.lng)}</dd>
        </div>
        <div class="spec">
          <dt>Độ cao</dt>
          <dd>{statue.elevation || 'Chưa có số liệu'}</dd>
        </div>
        <div class="spec">
          <dt>Vùng miền</dt>
          <dd>{statue.region}</dd>
        </div>
        <div class="spec">
          <dt>Giáo phận</dt>
          <dd>{statue.diocese}</dd>
        </div>
      </dl>

      <div class="body-grid">
        <div class="prose">
          {
            proseSections.map((section) => (
              <section class={section.lore ? 'lore' : undefined}>
                <h2>
                  {section.heading}
                  {section.lore && (
                    <span class="lore-badge" title="Nội dung lưu truyền trong dân gian, chưa có nguồn sử liệu kiểm chứng">
                      Chưa kiểm chứng
                    </span>
                  )}
                </h2>
                {section.lore && (
                  <p class="lore-note">
                    Phần dưới đây ghi lại chuyện kể, sự tích và giai thoại đang lưu truyền quanh linh
                    địa. Đây là tư liệu văn hoá dân gian, không phải sự kiện lịch sử đã kiểm chứng.
                  </p>
                )}
                {paragraphs(section.body).map((para) => (
                  <p class={section.lead ? 'lead' : undefined}>{para}</p>
                ))}
              </section>
            ))
          }
        </div>

        <aside class="rail">
          {
            mergedRoles.length > 0 && (
              <div class="rail-card">
                <h2>Vị trí trong chòm Bắc Đẩu</h2>
                {mergedRoles.map((entry) => (
                  <div class="role">
                    <div class="role-v">{versionLabel(entry.keys)}</div>
                    <div class="role-star">
                      {entry.role.star}
                      <code>{entry.role.code}</code>
                    </div>
                    <div class="role-desc">{entry.role.role}</div>
                  </div>
                ))}
              </div>
            )
          }

          <div class="rail-actions">
            <a class="btn btn-primary" href={`/ban-do/?linh-dai=${statue.id}`}>Xem trên bản đồ</a>
            <a class="btn btn-ghost" href="/chom-sao-bac-dau/">Khảo cứu Bắc Đẩu</a>
          </div>
        </aside>
      </div>
    </article>
  </div>

  <section class="sources">
    <div class="wrap">
      <h2>Nguồn dẫn</h2>
      <p class="sources-lead">
        Mọi luận điểm trên trang này đều dẫn về nguồn có thể kiểm chứng độc lập.
        Liên kết mở ra trang ngoài.
      </p>
      <SourceList sources={statue.sources} />
    </div>
  </section>

  <div class="wrap">
    <nav class="pager" aria-label="Linh địa liền kề">
      <a class="pg" href={statuePath(prev.id)}>
        <span>Linh địa trước</span>
        <b>{prev.name}</b>
      </a>
      <a class="pg next" href={statuePath(next.id)}>
        <span>Linh địa kế tiếp</span>
        <b>{next.name}</b>
      </a>
    </nav>
  </div>
</BaseLayout>

<style>
  .head {
    padding-block: 22px 40px;
  }
  .head h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.1rem, 4.6vw, 3.35rem);
    line-height: 1.14;
    letter-spacing: -0.015em;
    color: var(--text-strong);
    margin-bottom: 16px;
    max-width: 18ch;
  }
  .subtitle {
    font-family: var(--font-prose);
    font-style: italic;
    font-size: 1.18rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 52ch;
    margin-bottom: 20px;
  }
  .place {
    font-size: 14.5px;
    color: var(--text-primary);
  }
  .place .dot {
    color: var(--accent);
    margin-inline: 8px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 20px;
  }
  .tag {
    font-size: 12.5px;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: var(--radius);
    border: 1px solid var(--border-strong);
    color: var(--text-secondary);
  }
  .tag.diem {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    color: var(--accent-hover);
  }
  .tag.astro {
    border-color: color-mix(in srgb, var(--astro) 50%, transparent);
    color: var(--astro);
  }

  /* Anh hien nguyen khung, KHONG cat xen.
     Cat theo khung 16:9 se cat mat dau tuong o cac ban anh doc, ma pho tuong
     moi la chu the cua trang. Dung kieu trung bay bao tang: anh dat giua mot
     nen phang, gioi han chieu cao, giu nguyen ty le goc. */
  .hero-fig {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    padding: 20px;
  }
  .hero-fig :global(img) {
    width: auto;
    max-width: 100%;
    max-height: 560px;
    margin-inline: auto;
    border-radius: 2px;
  }
  .hero-fig figcaption {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--border-subtle);
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-tertiary);
    max-width: 78ch;
  }
  @media (max-width: 640px) {
    .hero-fig {
      padding: 12px;
    }
    .hero-fig :global(img) {
      max-height: 380px;
    }
  }

  /* Anh phu (galleryImages): dai thu nho ngang duoi anh chinh, kieu "product
     showcase". Khong phinh to chieu cao trang du co bao nhieu anh — thanh
     cuon ngang giu chieu cao co dinh, bam vao mo hop thoai xem anh lon (da
     co dieu huong prev/next) thay vi bay het ra thanh luoi day trang. */
  .gallery-wrap {
    margin-top: 16px;
  }
  .gallery-label {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: 10px;
  }
  .gallery {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    padding-bottom: 4px;
  }
  /* Cung nguyen tac voi .hero-fig: khong cat xen chu the. Anh tu can giua
     va giu nguyen ty le goc (contain), khong ep object-fit: cover. */
  .gallery-open {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 88px;
    height: 88px;
    padding: 0;
    border: 1px solid var(--border-subtle);
    background: var(--bg-raised);
    border-radius: 2px;
    cursor: zoom-in;
    scroll-snap-align: start;
    transition: border-color 0.15s;
  }
  .gallery-open:hover,
  .gallery-open:focus-visible {
    border-color: var(--accent);
  }
  .gallery-open :global(img) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    display: block;
  }

  /* Hop thoai xem anh lon. Nen toi phu kin man hinh, mot anh hien tai
     giua khung, dieu huong bang nut trai/phai hoac phim mui ten. */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    grid-template-columns: 64px 1fr 64px;
    align-items: center;
    background: rgba(4, 5, 9, 0.98);
  }
  .lb-stage {
    grid-column: 2;
    max-height: calc(100vh - 96px);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lb-item {
    max-width: min(92vw, 1100px);
    max-height: calc(100vh - 96px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .lb-item :global(img) {
    width: auto;
    max-width: 100%;
    max-height: calc(100vh - 150px);
    border-radius: 2px;
  }
  .lb-item figcaption {
    margin-top: 12px;
    padding-inline: 12px;
    font-size: 13px;
    line-height: 1.55;
    color: var(--text-tertiary);
    text-align: center;
    max-width: 70ch;
  }
  .lb-btn {
    border: 0;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    font-size: 22px;
    line-height: 1;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    cursor: pointer;
    transition: background 0.15s;
  }
  .lb-btn:hover {
    background: rgba(255, 255, 255, 0.18);
  }
  .lb-prev {
    grid-column: 1;
    justify-self: center;
  }
  .lb-next {
    grid-column: 3;
    justify-self: center;
  }
  .lb-close {
    position: absolute;
    top: 18px;
    right: 18px;
  }
  .lb-counter {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 13px;
    color: rgba(255, 255, 255, 0.7);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 640px) {
    .lightbox {
      grid-template-columns: 44px 1fr 44px;
    }
    .lb-btn {
      width: 40px;
      height: 40px;
      font-size: 18px;
    }
  }

  .specs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    margin-block: 48px;
  }
  /* Mot so linh dia chua co anh xac thuc. Khi khong co khoi anh chen giua,
     padding duoi cua .head va margin tren cua .specs cong don thanh khoang
     trong gan 90px. Chon lop lien ke de khep lai. */
  .head + .specs {
    margin-top: 4px;
    background: var(--border-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .spec {
    background: var(--bg-surface);
    padding: 20px 22px;
  }
  .spec dt {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: 8px;
  }
  .spec dd {
    font-family: var(--font-prose);
    font-size: 15.5px;
    color: var(--text-primary);
    line-height: 1.45;
  }
  .spec dd.num {
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 880px) {
    .specs {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 460px) {
    .specs {
      grid-template-columns: 1fr;
    }
  }

  .body-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 72px;
    padding-bottom: 72px;
    align-items: start;
  }
  @media (max-width: 940px) {
    .body-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
  .prose {
    max-width: 68ch;
  }
  .prose section {
    margin-bottom: 44px;
  }
  .prose h2 {
    font-family: var(--font-display);
    font-size: 1.62rem;
    font-weight: 600;
    color: var(--text-strong);
    line-height: 1.3;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .prose p {
    font-family: var(--font-prose);
    font-size: 1.12rem;
    line-height: 1.82;
    color: var(--text-primary);
  }
  .prose p.lead {
    font-size: 1.2rem;
    color: var(--text-strong);
  }
  .prose p + p {
    margin-top: 18px;
  }

  /* Muc truyen tung dan gian.
     Khac biet thi giac la co chu dich, khong phai trang tri: noi dung o day duoc
     phep ly ky va chua co nguon su lieu, nen phai nhin ra ngay la khac loai voi
     muc "Tu lieu lich su" ngay ben tren. Vien trai + nen mo + huy hieu. */
  .prose section.lore {
    border-left: 2px solid color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--bg-surface) 60%, transparent);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 24px 24px 4px 22px;
  }
  .prose section.lore h2 {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  .lore-badge {
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.02em;
    padding: 5px 10px;
    border-radius: var(--radius);
    border: 1px solid color-mix(in srgb, var(--accent) 50%, transparent);
    color: var(--accent-hover);
    white-space: nowrap;
  }
  .prose p.lore-note {
    font-family: var(--font-ui);
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 18px;
  }

  .rail {
    position: sticky;
    top: calc(var(--nav-height) + 24px);
    display: grid;
    gap: 24px;
  }
  @media (max-width: 940px) {
    .rail {
      position: static;
    }
  }
  .rail-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    padding: 22px;
  }
  .rail-card h2 {
    font-family: var(--font-ui);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: 16px;
  }
  .role {
    padding-block: 12px;
    border-top: 1px solid var(--border-subtle);
  }
  .role:first-of-type {
    border-top: 0;
    padding-top: 0;
  }
  .role-v {
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 4px;
  }
  .role-star {
    font-family: var(--font-prose);
    font-size: 15px;
    color: var(--text-primary);
    margin-bottom: 3px;
  }
  .role-star code {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--astro);
    margin-left: 5px;
  }
  .role-desc {
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--text-tertiary);
