<script>
  /**
   * Hop thoai xem anh phu (galleryImages) phong to, dieu huong bang nut hoac
   * phim mui ten. Chi chay khi trang co gallery; khong co thi bo qua het.
   */
  const gallery = document.getElementById('gallery');
  const lightbox = document.getElementById('lightbox');

  if (gallery && lightbox) {
    const items = Array.from(lightbox.querySelectorAll<HTMLElement>('[data-lb-item]'));
    const counter = lightbox.querySelector('[data-lb-current]');
    let current = 0;
    let lastFocused: HTMLElement | null = null;

    const show = (index: number) => {
      current = (index + items.length) % items.length;
      items.forEach((el, i) => {
        el.hidden = i !== current;
      });
      if (counter) counter.textContent = String(current + 1);
    };

    const open = (index: number) => {
      lastFocused = document.activeElement as HTMLElement | null;
      show(index);
      lightbox.hidden = false;
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      lightbox.querySelector<HTMLElement>('[data-lb-close]')?.focus();
    };

    const close = () => {
      lightbox.hidden = true;
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      lastFocused?.focus();
    };

    gallery.querySelectorAll<HTMLElement>('[data-gallery-open]').forEach((btn) => {
      btn.addEventListener('click', () => {
        open(Number(btn.dataset.galleryOpen));
      });
    });

    lightbox.querySelector('[data-lb-close]')?.addEventListener('click', close);
    lightbox.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(current - 1));
    lightbox.querySelector('[data-lb-next]')?.addEventListener('click', () => show(current + 1));

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });

    document.addEventListener('keydown', (e) => {
      if (lightbox.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(current - 1);
      else if (e.key === 'ArrowRight') show(current + 1);
    });
  }
</script>
