---
import { Image } from 'astro:assets';

import BaseLayout from '../layouts/BaseLayout.astro';
import StatueIndex from '../components/StatueIndex.astro';
import ConstellationDiagram from '../components/ConstellationDiagram.astro';

import { SITE_DESCRIPTION } from '../config/site.js';
import { MARIAN_STATUES_DATA } from '../data/statues.js';
import { getPhoto } from '../lib/photos.js';
import { getYearRange, statuePath } from '../lib/statues.js';
import { buildItemListSchema, buildWebSiteSchema } from '../lib/seo.js';

const total = MARIAN_STATUES_DATA.length;
const { min: earliest, max: latest } = getYearRange();

const laVang = MARIAN_STATUES_DATA.find((s) => s.id === 'lavang');
const heroPhoto = getPhoto(laVang?.realImage);

const title = 'Linh đài Đức Mẹ trên bản đồ Việt Nam';
const schemas = [buildWebSiteSchema(SITE_DESCRIPTION), buildItemListSchema()];

/** Cot moc dong thoi gian, lay tu du lieu that. */
const milestones = [
  { id: 'lavang', note: 'Giáo dân lánh nạn cấm đạo tại La Vang. Khởi điểm của toàn bộ bộ tư liệu.' },
  { id: 'trakieu', note: 'Biến cố Trà Kiệu giữa phong trào Văn Thân, Quảng Nam.' },
  { id: 'tapao', note: 'Năm pho tượng dựng dưới thời Đệ nhất Cộng hòa, cốt lõi của giả thuyết Bắc Đẩu.' },
  { id: 'baidau', note: 'Linh đài Bãi Dâu trên sườn Núi Lớn, Vũng Tàu.' },
  { id: 'nuicui', note: 'Núi Cúi, Đồng Nai. Linh địa mới nhất trong danh mục.' },
].map((m) => {
  const statue = MARIAN_STATUES_DATA.find((s) => s.id === m.id);
  return { ...m, year: statue.year, name: statue.name };
});
---

<BaseLayout title={title} description={SITE_DESCRIPTION} schemas={schemas}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1 class="font-display">
          Linh đài Đức Mẹ trên <em>bản đồ</em> Việt Nam
        </h1>
        <p>
          Tư liệu lịch sử, tọa độ và ảnh xác thực của {total} trung tâm hành hương Thánh Mẫu.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="/ban-do/">Mở bản đồ tương tác</a>
          <a class="btn btn-ghost" href="/chom-sao-bac-dau/">Đọc khảo cứu Bắc Đẩu</a>
        </div>
      </div>

      {
        heroPhoto && (
          <figure class="hero-figure">
            <a href={statuePath('lavang')}>
              <Image
                src={heroPhoto}
                alt="Linh đài Đức Mẹ La Vang tại Quảng Trị, trung tâm Thánh Mẫu toàn quốc từ năm 1961"
                widths={[400, 640, 900]}
                sizes="(max-width: 860px) 100vw, 420px"
                loading="eager"
                fetchpriority="high"
                format="avif"
              />
            </a>
            <figcaption>
              Linh đài Đức Mẹ La Vang, Quảng Trị. Linh địa lâu đời nhất trong bộ tư liệu,
              khởi từ năm {earliest}. Nguồn: Wikimedia Commons.
            </figcaption>
          </figure>
        )
      }
    </div>
  </section>

  <section class="thesis">
    <div class="wrap thesis-grid">
      <div>
        <h2 class="font-display">Bảy linh đài, một chòm sao</h2>
        <p>
          Từ thập niên 1960, nhiều tài liệu Công giáo miền Nam ghi lại một nhận xét lặp đi
          lặp lại: vị trí các pho tượng Đức Mẹ dựng trong giai đoạn 1959 tới 1961, đặt cạnh
          hai linh địa cổ La Vang và Trà Kiệu, phác nên hình thế chòm Bắc Đẩu trên bản đồ
          đất nước.
        </p>
        <p>
          Trang khảo cứu đối chiếu bốn cách đọc khác nhau của giả thuyết này với tọa độ thực
          địa, kèm nguồn dẫn cho từng luận điểm. Chúng tôi trình bày cả chứng cứ lẫn giới hạn
          của nó, không khẳng định thay người đọc.
        </p>
        <a class="link-more" href="/chom-sao-bac-dau/">Xem bốn phiên bản đối chiếu</a>
      </div>

      <ConstellationDiagram />
    </div>
  </section>

  <section class="index" id="danh-muc">
    <div class="wrap">
      <div class="index-head">
        <h2 class="font-display">{total} linh địa Thánh Mẫu</h2>
        <p>
          Sắp theo vùng miền và năm thành lập. Mỗi linh địa có một trang riêng gồm tư liệu
          lịch sử, truyền tụng dân gian, tọa độ GPS và danh mục nguồn dẫn.
        </p>
      </div>
      <StatueIndex />
    </div>
  </section>

  <section class="timeline">
    <div class="wrap">
      <h2 class="font-display">Hai thế kỷ, năm cột mốc</h2>
      <p class="timeline-lead">
        Từ một gốc cây lá vằng giữa rừng Quảng Trị năm {earliest}, tới quảng trường bê tông
        ở Đồng Nai năm {latest}.
      </p>
      <div class="scale">
        <ol class="marks">
          {
            milestones.map((m) => (
              <li class="mark">
                <a href={statuePath(m.id)}>
                  <span class="mark-year">{m.year}</span>
                  <span class="mark-label">{m.note}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero: chia lech, anh that o cot phai ---------- */
  .hero {
    padding-block: 56px 64px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 56px;
    align-items: center;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.3rem, 4.6vw, 3.5rem);
    line-height: 1.13;
    letter-spacing: -0.015em;
    color: var(--text-strong);
    margin-bottom: 20px;
    text-wrap: balance;
  }
  /* Giu "bản đồ" tren cung mot dong: tach doi cum tu nay lam vo ca nhip doc
     lan diem nhan chu nghieng. */
  .hero h1 em {
    color: var(--accent-hover);
    white-space: nowrap;
  }
  .hero p {
    font-family: var(--font-prose);
    font-size: 1.16rem;
    line-height: 1.72;
    color: var(--text-secondary);
    max-width: 34ch;
    margin-bottom: 34px;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  /* Cung kieu trung bay nhu trang chi tiet: khong cat xen pho tuong. */
  .hero-figure {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    padding: 16px;
  }
  .hero-figure :global(img) {
    width: auto;
    max-width: 100%;
    max-height: 420px;
    margin-inline: auto;
    border-radius: 2px;
  }
  .hero-figure figcaption {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--border-subtle);
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--text-tertiary);
  }
  @media (max-width: 860px) {
    .hero {
      padding-block: 40px 48px;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .hero p {
      max-width: 100%;
    }
    .hero-figure :global(img) {
      max-height: 300px;
    }
  }

  /* ---------- Nut bam ---------- */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 13px 24px;
    border-radius: var(--radius);
    font-size: 14.5px;
    font-weight: 600;
    white-space: nowrap;
    border: 1px solid transparent;
    transition: transform 0.16s, background 0.2s, border-color 0.2s, color 0.2s;
  }
  .btn:active {
    transform: translateY(1px);
  }
  .btn-primary {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .btn-primary:hover {
    background: var(--accent-hover);
  }
  .btn-ghost {
    border-color: var(--border-strong);
    color: var(--text-primary);
    background: var(--bg-surface);
  }
  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent-hover);
  }

  /* ---------- Luan de ---------- */
  .thesis {
    padding-block: 84px;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
  }
  .thesis-grid {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 72px;
    align-items: center;
  }
  .thesis h2 {
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    font-weight: 600;
    line-height: 1.22;
    color: var(--text-strong);
    margin-bottom: 20px;
    max-width: 24ch;
  }
  .thesis p {
    font-family: var(--font-prose);
    font-size: 1.06rem;
    line-height: 1.78;
    color: var(--text-secondary);
    max-width: 62ch;
    margin-bottom: 18px;
  }
  .link-more {
    font-family: var(--font-ui);
    font-size: 14.5px;
    font-weight: 600;
    color: var(--accent);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    padding-bottom: 2px;
    transition: border-color 0.2s;
  }
  .link-more:hover {
    border-bottom-color: var(--accent);
  }
  @media (max-width: 900px) {
    .thesis {
      padding-block: 56px;
    }
    .thesis-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  /* ---------- Muc luc ---------- */
  .index {
    padding-block: 84px;
  }
  .index-head {
    margin-bottom: 52px;
    max-width: 60ch;
  }
  .index-head h2 {
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    font-weight: 600;
    line-height: 1.22;
    color: var(--text-strong);
    margin-bottom: 16px;
  }
  .index-head p {
    font-family: var(--font-prose);
    font-size: 1.05rem;
    line-height: 1.76;
    color: var(--text-secondary);
  }
  @media (max-width: 820px) {
    .index {
      padding-block: 56px;
    }
  }

  /* ---------- Dong thoi gian ---------- */
  .timeline {
    padding-block: 84px;
    background: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
  }
  .timeline h2 {
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    font-weight: 600;
    color: var(--text-strong);
    margin-bottom: 14px;
  }
  .timeline-lead {
    font-family: var(--font-prose);
    color: var(--text-secondary);
    max-width: 58ch;
    line-height: 1.76;
    margin-bottom: 48px;
  }
  .scale {
    border-top: 1px solid var(--border-strong);
    padding-top: 34px;
  }
  .marks {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    list-style: none;
  }
  .mark {
    flex: 1;
    min-width: 0;
    position: relative;
    padding-top: 26px;
  }
  .mark::before {
    content: '';
    position: absolute;
    top: -35px;
    left: 0;
    width: 1px;
    height: 18px;
    background: var(--accent);
  }
  .mark a {
    display: block;
  }
  .mark-year {
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 600;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    position: absolute;
    top: 0;
    left: 0;
  }
  .mark-label {
    font-family: var(--font-prose);
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--text-secondary);
    padding-right: 14px;
    display: block;
  }
  .mark a:hover .mark-label {
    color: var(--text-primary);
  }
  @media (max-width: 820px) {
    .timeline {
      padding-block: 56px;
    }
    .marks {
      flex-direction: column;
      gap: 22px;
    }
    .mark {
      padding-top: 0;
      padding-left: 20px;
    }
    .mark::before {
      top: 4px;
      left: 0;
      height: 100%;
    }
    .mark-year {
      position: static;
      display: block;
      margin-bottom: 3px;
    }
  }
</style>
